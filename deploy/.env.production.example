# Produção do Atlas (deploy/docker-compose.prod.yml). Copie para deploy/.env e preencha.
# Nunca versione o deploy/.env.

# Domínio público (DNS A/AAAA apontando para o host) e e-mail do Let's Encrypt.
DOMAIN=atlas.exemplo.com.br
ACME_EMAIL=voce@exemplo.com.br

# Postgres (só na rede interna). Gere uma senha longa: openssl rand -base64 32
# (evite "$": o compose o interpreta como variável; use "$$" para um "$" literal)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=
POSTGRES_DB=atlas

# Login/cadastro: tentativas por minuto (IP e e-mail).
AUTH_RATE_LIMIT_MAX=5
LOG_LEVEL=info
# Jobs (TDEE adaptativo, insights, resumo semanal, limpezas).
JOBS_ENABLED=true

# IA (opcional). Sem chave, o parser usa regras e o Coach fica indisponível (ADR-025/056).
ANTHROPIC_API_KEY=
AI_MODEL_CHAT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5
AI_DAILY_TOKEN_LIMIT=200000

# Backup diário (ADR-059): horário no fuso abaixo e retenção.
BACKUP_TZ=America/Sao_Paulo
BACKUP_CRON=30 3 * * *
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Cópia externa (recomendado): bucket S3 compatível (AWS, Backblaze B2, Cloudflare R2...).
# BACKUP_S3_URI=s3://meu-bucket/atlas
# BACKUP_S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto

# Versão das imagens (tag local); útil para voltar a uma versão anterior.
# ATLAS_VERSION=latest
