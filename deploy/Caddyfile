# Proxy de borda (ADR-058): TLS automático (Let's Encrypt) e um domínio só.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# API direto (sem passar pelo Next): SSE do Coach sem buffer, um proxy confiável só.
	handle /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
