# Ambiente: development | test | production
NODE_ENV=development

# Postgres (docker compose sobe em localhost:5432)
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas

# Testes de integração: se definida, usa este Postgres em vez do Testcontainers (ADR-010)
# TEST_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas_test

# API
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info
# Origin do front (CORS e verificação de Origin)
WEB_ORIGIN=http://localhost:3000
# Cookie Secure (padrão: true em produção, false fora dela)
# COOKIE_SECURE=false
# Tentativas/min em login (IP e e-mail) e cadastro (IP)
AUTH_RATE_LIMIT_MAX=5
# Proxies confiáveis (X-Forwarded-For): loopback | lista de IPs/CIDRs separada por vírgula
TRUST_PROXY=loopback

# Web: para onde o Next encaminha /api/v1/* (ADR-007)
API_URL=http://localhost:3001

# IA. Nunca expor no front. Sem chave, o parser usa as regras (ADR-025).
# ANTHROPIC_API_KEY=
# Modelos (P10.6): conversa = Sonnet mais recente; parsing/extração = Haiku mais recente.
AI_MODEL_CHAT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5
# Tokens por usuário por dia no Coach (ADR-056)
AI_DAILY_TOKEN_LIMIT=200000
# Só para E2E/dev: Coach roteirizado sem chave (recusado em produção)
AI_FAKE=false
# Worker pg-boss (ADR-049)
JOBS_ENABLED=false

# Vercel (ADR-064): API Fastify embutida no Next em /api/v1 (sem rewrite para API_URL).
# EMBEDDED_API=true
# Conexões do pool por instância serverless
# DB_POOL_MAX=3
# Segredo da rodada horária por HTTP (POST /api/v1/internal/tick), 32+ caracteres
# CRON_SECRET=
# Ambiente do app quando o hospedeiro fixa NODE_ENV (só E2E: APP_ENV=test; nunca em produção)
# APP_ENV=
